 .pkr-cap-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:6px}
-.pkr-grid-tools{display:grid;gap:6px;padding:8px;border:2px solid #69759d;background:#11162d;box-shadow:3px 3px 0 #050714;font-size:13px}
-.pkr-grid-tools input,.pkr-grid-tools select{min-height:36px;border:2px solid #4c587d;background:#080d20;color:#eef2ff;padding:6px 8px;font:inherit;min-width:0}
+.pkr-grid-tools{display:grid;gap:6px;padding:8px;border:2px solid #69759d;background:var(--pkr-panel-deep);box-shadow:3px 3px 0 #050714;font-size:13px}
+.pkr-grid-tools input,.pkr-grid-tools select{min-height:36px;border:2px solid var(--pkr-border-dim);background:var(--pkr-shade);color:#eef2ff;padding:6px 8px;font:inherit;min-width:0}
 .pkr-grid-tools__sort{display:grid;grid-template-columns:minmax(0,1fr) 36px auto;gap:6px}
-.pkr-grid-dir,.pkr-grid-select{min-height:36px;border:2px solid #4c587d;background:#080d20;color:#eef2ff;font:inherit;font-weight:900;padding:0 8px}
+.pkr-grid-dir,.pkr-grid-select{min-height:36px;border:2px solid var(--pkr-border-dim);background:var(--pkr-shade);color:#eef2ff;font:inherit;font-weight:900;padding:0 8px}
 .pkr-grid-select.is-on{border-color:var(--pkr-accent,#fbbf24);color:var(--pkr-accent,#fbbf24)}
 .pkr-grid-chips{display:flex;flex-wrap:wrap;gap:5px}
-.pkr-grid-chip{min-height:30px;border:1px solid #4c587d;background:#080d20;color:#c7cee8;padding:3px 7px;font:inherit;font-size:12px;font-weight:900}
+.pkr-grid-chip{min-height:30px;border:1px solid var(--pkr-border-dim);background:var(--pkr-shade);color:#c7cee8;padding:3px 7px;font:inherit;font-size:12px;font-weight:900}
 .pkr-grid-chip[aria-pressed="true"]{border-color:var(--pkr-accent,#fbbf24);background:#3c2b0b;color:#ffe08a}
 .pkr-grid-tools select.pkr-grid-chip--type{min-height:30px;padding:3px 6px;font-size:12px}
 .pkr-grid-scroll{position:relative;max-height:min(68vh,560px);min-height:160px;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain}
