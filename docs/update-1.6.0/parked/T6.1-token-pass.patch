-.pkr-grid-back{min-width:36px;min-height:36px;border:2px solid #4c587d;background:#11162d;color:var(--pkr-ink-text,#eef2ff);font-size:16px;font-weight:900}
+.pkr-grid-back{min-width:36px;min-height:36px;border:2px solid var(--pkr-border-dim);background:var(--pkr-panel-deep);color:var(--pkr-ink-text,#eef2ff);font-size:16px;font-weight:900}
 .pkr-grid-title{flex:1;min-width:0;margin:0;font-size:14px;font-weight:900;text-transform:uppercase;color:var(--pkr-ink-text,#eef2ff);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
-.pkr-cap-meter{display:inline-flex;flex-direction:column;gap:2px;flex-shrink:0;padding:3px 6px;border:1px solid #4c587d;background:#080d20;color:var(--pkr-ink-muted,#aeb7d2);font-size:12px;font-weight:900;font-variant-numeric:tabular-nums}
+.pkr-cap-meter{display:inline-flex;flex-direction:column;gap:2px;flex-shrink:0;padding:3px 6px;border:1px solid var(--pkr-border-dim);background:var(--pkr-shade);color:var(--pkr-ink-muted,#aeb7d2);font-size:12px;font-weight:900;font-variant-numeric:tabular-nums}
 .pkr-cap-meter__bar{display:block;height:4px;min-width:56px;background:#1c2340}.pkr-cap-meter__bar i{display:block;height:100%;background:#4bd5b1}
 .pkr-cap-meter--warn{border-color:#d69e2e;color:#ffe08a}.pkr-cap-meter--warn .pkr-cap-meter__bar i{background:#f2b632}
